{
    "name": "dleno/hyperf-env-multi",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "hyperf"
    ],
    "description": "",
    "autoload": {
        "psr-4": {
            "Dleno\\HyperfEnvMulti\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfTest\\": "tests"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-swoole": ">=6.2",
        "hyperf/collection": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/context": "~3.2.0",
        "hyperf/contract": "~3.2.0",
        "hyperf/event": "~3.2.0",
        "hyperf/framework": "~3.2.0",
        "hyperf/support": "~3.2.0",
        "symfony/finder": "^6.4 || ^7.0",
        "vlucas/phpdotenv": "^5.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "hyperf/di": "~3.2.0",
        "hyperf/testing": "~3.2.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^11.0",
        "swoole/ide-helper": "^6.2"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "co-phpunit -c phpunit.xml --colors=always",
        "analyse": "phpstan analyse --memory-limit 300M -l 0 ./src",
        "cs-fix": "php-cs-fixer fix $1"
    },
    "extra": {
        "hyperf": {
            "config": "Dleno\\HyperfEnvMulti\\ConfigProvider"
        }
    }
}
